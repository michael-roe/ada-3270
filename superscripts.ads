package Superscripts is

   Superscript_Zero  : constant Wide_Character :=
      Wide_Character'Val (16#2070#);

   --
   --  Superscript_One, Superscript_Two and Superscript_Three are in
   --  ISO Latin 1.
   --

   Superscript_Four  : constant Wide_Character :=
      Wide_Character'Val (16#2074#);

   Superscript_Five  : constant Wide_Character :=
      Wide_Character'Val (16#2075#);

   Superscript_Six   : constant Wide_Character :=
      Wide_Character'Val (16#2076#);

   Superscript_Seven : constant Wide_Character :=
      Wide_Character'Val (16#2077#);

   Superscript_Eight : constant Wide_Character :=
      Wide_Character'Val (16#2078#);

   Superscript_Nine  : constant Wide_Character :=
      Wide_Character'Val (16#2079#);

end Superscripts;
