   procedure Append (
      P : Page_1025;
      V : in out Byte_Vectors.Vector;
      S : Wide_String) is
      C : Integer;
      B : Buffer.Byte;
      Found : Boolean;
   begin

      for J in S'Range loop
         C := Wide_Character'Pos (S (J));

         if C < 128 then
            V.Append (Bottom_Half_Table (Seven_Bit (C)));
         else
            Found := False;
            for K in Top_Index loop
               if Top_Half_Table (K).From = S (J) then
                  V.Append (Top_Half_Table (K).To);
                  Found := True;
               end if;
            end loop;
            if not Found then
               Code_Page_310.Append (V, S (J));
            end if;
         end if;
      end loop;

   end Append;

